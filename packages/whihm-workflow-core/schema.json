{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whihm:workflow:v1",
  "title": "WHIHM Workflow Document v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflowInput"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflowOutput"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "metadata": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "review": {
      "type": "object"
    },
    "variants": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "workflowId",
    "name",
    "nodes",
    "edges",
    "inputs",
    "outputs",
    "assets"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "executor": {
          "$ref": "#/$defs/executor"
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "parameters": {
          "type": "object"
        },
        "assetRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        },
        "executionPolicy": {
          "type": "object"
        },
        "retryPolicy": {
          "type": "object"
        },
        "fallbackPolicy": {
          "type": "object"
        },
        "costPolicy": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "executor",
        "inputs",
        "outputs",
        "parameters"
      ],
      "additionalProperties": false
    },
    "executor": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "remote-model",
            "local-ai",
            "utility",
            "control"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "model": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mayCostMoney": {
          "type": "boolean"
        },
        "requiresConfirmation": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "mayCostMoney",
        "requiresConfirmation"
      ],
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "description": {
          "type": "string"
        },
        "cardinality": {
          "enum": [
            "one",
            "many"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "portId": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "nodeId",
        "portId"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "source": {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
            },
            "portId": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "nodeId",
            "portId"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
            },
            "portId": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "nodeId",
            "portId"
          ],
          "additionalProperties": false
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "localPath": {
          "type": "string"
        },
        "remoteUrl": {
          "type": "string"
        },
        "checksum": {
          "type": "object",
          "properties": {
            "algorithm": {
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "workflowInput": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "cardinality": {
          "enum": [
            "one",
            "many"
          ]
        },
        "title": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
              },
              "portId": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
              }
            },
            "required": [
              "nodeId",
              "portId"
            ],
            "additionalProperties": false
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "targets"
      ],
      "additionalProperties": false
    },
    "workflowOutput": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "cardinality": {
          "enum": [
            "one",
            "many"
          ]
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
            },
            "portId": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "nodeId",
            "portId"
          ],
          "additionalProperties": false
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "source"
      ],
      "additionalProperties": false
    }
  }
}
