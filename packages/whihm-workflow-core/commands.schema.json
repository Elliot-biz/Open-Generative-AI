{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whihm:workflow-edit:v1",
  "title": "WHIHM deterministic edit batch v1",
  "type": "object",
  "properties": {
    "commandVersion": {
      "const": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "expectedWorkflowHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allowedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/(?:[^~]|~[01])*$"
      }
    },
    "dryRun": {
      "type": "boolean"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/precondition"
      }
    },
    "metadata": {
      "type": "object"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "commandVersion",
    "commands"
  ],
  "additionalProperties": false,
  "$defs": {
    "precondition": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "pattern": "^/(?:[^~]|~[01])*$"
        },
        "exists": {
          "type": "boolean"
        },
        "equals": {}
      },
      "required": [
        "at"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "exists"
          ]
        },
        {
          "required": [
            "equals"
          ]
        }
      ],
      "not": {
        "properties": {
          "exists": {
            "const": false
          }
        },
        "required": [
          "exists",
          "equals"
        ]
      }
    },
